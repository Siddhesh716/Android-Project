<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF5733" android:endColor="#C70039" android:angle="45"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF6F61" android:endColor="#FF3D00" android:angle="45"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</selector>