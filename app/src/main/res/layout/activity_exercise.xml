<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ExerciseActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <!-- PAGE HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXERCISES"
            android:textColor="@color/text_color"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Train with purpose."
            android:textColor="@color/text_color"
            android:textSize="29sp"
            android:textStyle="bold"
            android:layout_marginTop="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your weekly training plan"
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- HERO IMAGE -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="22dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@android:color/white">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/exercise_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/exe"
                    android:scaleType="centerCrop"
                    android:contentDescription="Exercise Training"
                    android:alpha="0.92" />

                <!-- DARK OVERLAY -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#55000000" />

                <!-- HERO TEXT -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WEEKLY TRAINING"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your week. Your progress."
                        android:textColor="@android:color/white"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp" />

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- TODAY'S SESSION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TODAY'S PLAN"
            android:textColor="@color/text_color"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.07"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/todayExerciseCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- TODAY LABEL -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textColor="@color/buttonBackground"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/todayExerciseDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MONDAY"
                        android:textColor="@color/buttonBackground"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginStart="7dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/todayExerciseStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TODAY"
                        android:textColor="@color/buttonBackground"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:background="@drawable/today_badge_background" />

                </LinearLayout>

                <!-- EXERCISE NAME -->

                <TextView
                    android:id="@+id/todayExerciseName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Running"
                    android:textColor="@color/text_color"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/todayExerciseCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CARDIO • ENDURANCE"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/todayExerciseDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Build endurance and stay active."
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="12dp" />

                <!-- EDIT BUTTON -->

                <TextView
                    android:id="@+id/todayEditButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="Edit Workout  →"
                    android:textColor="@color/buttonBackground"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- WEEKLY PLAN -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WEEKLY PLAN"
                android:textColor="@color/text_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.07" />

            <TextView
                android:id="@+id/weeklyPlanCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 DAYS"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- WEEKLY EXERCISE LIST -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp">

            <ListView
                android:id="@+id/exercise_list"
                android:layout_width="match_parent"
                android:layout_height="390dp"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:background="@android:color/transparent"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:clipToPadding="false"
                android:scrollbars="none" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>