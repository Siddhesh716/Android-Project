<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <EditText
                android:id="@+id/heightInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Height (cm)"
                android:inputType="numberDecimal"
                android:padding="15dp"
                android:background="@drawable/edittext_style"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textColorHint="@android:color/black"
                android:layout_marginTop="50dp"/>

            <EditText
                android:id="@+id/weightInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Weight (kg)"
                android:inputType="numberDecimal"
                android:padding="15dp"
                android:background="@drawable/edittext_style"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textColorHint="@android:color/black"
                android:layout_marginTop="15dp"/>

            <Button
                android:id="@+id/calculateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculate BMI"
                android:textSize="22sp"
                android:textStyle="bold"
                android:padding="15dp"
                android:textColor="@android:color/white"
                android:background="@drawable/button_style"
                android:layout_marginTop="15dp"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/resultText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your BMI Will Appear Here!"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp"
                android:layout_gravity="center"/>

            <TableLayout
                android:id="@+id/bmiTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1"
                android:layout_marginTop="20dp"
                android:background="@android:color/darker_gray">

                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Category"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:padding="8dp"
                        android:textColor="@android:color/black"
                        android:background="@drawable/border"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BMI Range"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:padding="8dp"
                        android:textColor="@android:color/black"
                        android:background="@drawable/border"
                        android:gravity="center"/>
                </TableRow>

                <TableRow>
                    <TextView android:text="Severe Thinness" android:textColor="@android:color/black" android:padding="15dp" android:background="@drawable/border"/>
                    <TextView android:text="Less than 16" android:textColor="@android:color/black" android:padding="15dp" android:gravity="center"
                        android:textAlignment="center"  android:background="@drawable/border"/>
                </TableRow>
                <TableRow>
                    <TextView android:text="Moderate Thinness" android:textColor="@android:color/black" android:padding="15dp" android:background="@drawable/border"/>
                    <TextView android:text="16 - 17" android:textColor="@android:color/black" android:padding="15dp" android:gravity="center"
                        android:textAlignment="center"  android:background="@drawable/border"/>
                </TableRow>
                <TableRow>
                    <TextView android:text="Mild Thinness" android:textColor="@android:color/black" android:padding="15dp" android:background="@drawable/border"/>
                    <TextView android:text="17 - 18.5" android:textColor="@android:color/black" android:padding="15dp" android:gravity="center"
                        android:textAlignment="center"  android:background="@drawable/border"/>
                </TableRow>
                <TableRow>
                    <TextView android:text="Normal Weight" android:textColor="@android:color/black" android:padding="15dp" android:background="@drawable/border"/>
                    <TextView android:text="18.5 - 24.9" android:textColor="@android:color/black" android:padding="15dp" android:gravity="center"
                        android:textAlignment="center"  android:background="@drawable/border"/>
                </TableRow>
                <TableRow>
                    <TextView android:text="Overweight" android:textColor="@android:color/black" android:padding="15dp" android:background="@drawable/border"/>
                    <TextView android:text="25 - 29.9" android:textColor="@android:color/black" android:padding="15dp" android:gravity="center"
                        android:textAlignment="center"  android:background="@drawable/border"/>
                </TableRow>
                <TableRow>
                    <TextView android:text="Obesity Class 1" android:textColor="@android:color/black" android:padding="15dp" android:background="@drawable/border"/>
                    <TextView android:text="30 - 34.9" android:textColor="@android:color/black" android:padding="15dp" android:gravity="center"
                        android:textAlignment="center"  android:background="@drawable/border"/>
                </TableRow>
                <TableRow>
                    <TextView android:text="Obesity Class 2" android:textColor="@android:color/black" android:padding="15dp" android:background="@drawable/border"/>
                    <TextView android:text="35 - 39.9" android:textColor="@android:color/black" android:padding="15dp" android:gravity="center"
                        android:textAlignment="center"  android:background="@drawable/border"/>
                </TableRow>
                <TableRow>
                    <TextView android:text="Obesity Class 3" android:textColor="@android:color/black" android:padding="15dp" android:background="@drawable/border"/>
                    <TextView android:text="More than 40" android:textColor="@android:color/black" android:padding="15dp" android:gravity="center"
                        android:textAlignment="center"  android:background="@drawable/border"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>