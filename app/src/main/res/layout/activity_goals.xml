<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".GoalsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <!-- PAGE HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GOALS"
            android:textColor="@color/text_color"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Build your next milestone."
            android:textColor="@color/text_color"
            android:textSize="29sp"
            android:textStyle="bold"
            android:layout_marginTop="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set goals. Track progress. Keep moving."
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- GOAL HERO VIDEO -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@android:color/black"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <VideoView
                    android:id="@+id/goals_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#55000000" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOUR FITNESS JOURNEY"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Progress starts with a goal."
                        android:textColor="@android:color/white"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp" />

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- ACTIVE GOAL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTIVE GOAL"
            android:textColor="@color/text_color"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.07"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/activeGoalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="●"
                        android:textColor="@color/buttonBackground"
                        android:textSize="20sp"
                        android:background="@drawable/circle_background" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/activeGoalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CURRENT FOCUS"
                            android:textColor="@color/buttonBackground"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/activeGoalName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Run 2 km"
                            android:textColor="@color/text_color"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:layout_marginTop="3dp" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/activeGoalDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Build your running distance and improve endurance."
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="15dp" />

                <!-- PROGRESS HEADER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="17dp">

                    <TextView
                        android:id="@+id/activeGoalProgressValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 / 2 km"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/activeGoalProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/buttonBackground"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/activeGoalProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/buttonBackground"
                    android:backgroundTint="#E8E8E8" />

                <Button
                    android:id="@+id/updateGoalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="UPDATE PROGRESS"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="18dp" />

                <Button
                    android:id="@+id/startGoalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="START"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- MY GOALS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MY GOALS"
                android:textColor="@color/text_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.07" />

            <TextView
                android:id="@+id/goalsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 GOALS"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:id="@+id/goalsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />

        </androidx.cardview.widget.CardView>

        <!-- ADD GOAL -->

        <Button
            android:id="@+id/add_goal_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="+  Add New Goal"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="4dp" />

    </LinearLayout>

</ScrollView>